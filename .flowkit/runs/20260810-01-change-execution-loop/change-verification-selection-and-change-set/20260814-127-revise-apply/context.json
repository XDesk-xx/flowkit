      "findings": [
        {
          "id": "E1-RA-008",
          "severity": "blocking",
          "blockingAuthority": "author",
          "title": "Contract Reset recovery 仍用 post-reset current generation 重建 historical pending Run",
          "problem": "新 E1 spec 已明确 recoverContractResetPendingRun 必须基于 target pending Run 的 persisted entry lineage；122 production implementation 仍在 isContractResetOnlyPendingDrift 中调用 deriveSemanticInputs(current snapshot, context.action, descriptorsFromContext(context))。deriveSemanticInputs→collectContractRefs 又调用 computeResetAwareLineage(snapshot,...).artifact，因此 Reset 正确排除旧 proposal/apply generation 后，旧 pending Apply/revise-apply recovery 仍会要求 current generation producer，重现 `apply has no immutable propose producer generation` deadlock。",
          "contractRef": "specs/flowkit-formal-fact-reader-and-persistence Requirement: Contract Reset recovery 必须保持 narrow admission；docs/flowkit-self-hosting-bootstrap-and-migration.md persisted-entry invariant",
          "invariant": "historical pending Run 的 entry truth 来自其 persisted context/inputRef/producer-review lineage；Contract Reset 只改变 currentness，不能迫使 recovery 用新 generation 重新解释旧 Run。",
          "requiredOutcome": "为 reset recovery 增加严格 historical reconstruction：以 target context.inputRef、consumed review result、reviewed producer ResultRefs及其 persisted contract/Owner refs重建原始 entry semantic view；只将 current applicable Contract Reset作为允许的唯一差异。缺失、歧义、hash mismatch或 mixed drift 均 fail closed，不得 fallback 到 current-generation producer lookup。",
          "acceptance": [
            "synthetic approved proposal/review→pending apply→Contract Reset 后，旧 proposal generation 已 non-current 仍可由 official recovery取消为 superseded-by-owner-contract-reset",
            "同样覆盖 pending revise-apply historical lineage",
            "recovery 不要求 post-reset current propose producer",
            "missing/ambiguous historical refs、multiple pending 与 mixed semantic drift 全部 fail closed"
          ]
        },
        {
          "id": "E1-RA-011",
          "severity": "blocking",
          "blockingAuthority": "author",
          "title": "125 actualChangeSet 收录了 Core-owned verification.md 的 pre-publication bytes，record 不再描述最终 candidate",
          "problem": "125 在 Core 写入本 Run的 canonical verification.md 之前就从 Git base→post-action snapshot计算 actualChangeSet；deriveActualChangeSetFromCanonicalBase 只排除 .flowkit 路径，没有排除当前 Change 的 Core-owned verification.md。随后 publishVerificationSelection 重写 verification.md。因此 immutable selection record 中 verification.md 的 contentFingerprintAfter 绑定的是旧 publication，而最终 candidate 已是新 publication。",
          "contractRef": "openspec/changes/change-verification-selection-and-change-set/design.md §6 entry snapshot 与 actualChangeSet；tasks.md 4.2/4.3；specs/flowkit-change-verification-selection/spec.md Requirement: Core 必须派生 canonical actualChangeSet",
          "invariant": "reserved Core-owned verification publication 不进入 Author candidate sets；对 actualChangeSet 中保留的每个 file，contentFingerprintAfter 必须描述最终 candidate bytes，而不是 publication 前的临时状态。",
          "requiredOutcome": "按 approved reserved-path contract 修正 observation/selection：当前 Run 的 Core-owned verification publication 不得作为 candidate mutation 参与 observedActionMutations/actualChangeSet/verificationScope；对仍保留在 actualChangeSet 的每个 file，最终 immutable record fingerprint 必须与 terminal candidate bytes一致。不得通过在 record 中保留 pre-publication verification.md hash 规避。",
          "acceptance": [
            "v5 Apply/revise-apply publication 后，actualChangeSet 不包含当前 Run 的 Core-owned canonical verification.md publication",
            "对 immutable selection actualChangeSet 的所有 non-delete files 重算 terminal candidate SHA-256，全部与 contentFingerprintAfter 一致",
            "verificationScope 不因 Core 自己写 verification.md 而扩大",
            "增加 regression 覆盖 entry 时已有旧 verification.md、Core publication 后 bytes变化的场景"
          ]
        }
      ],
      "convergence": [
        {
          "findingId": "E1-RA-008",
          "state": "still-open"
        },
