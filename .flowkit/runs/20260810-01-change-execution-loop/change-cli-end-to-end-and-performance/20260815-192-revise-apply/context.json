      "findings": [
        {
          "id": "G1-RA-001",
          "severity": "blocking",
          "blockingAuthority": "author",
          "title": "archive CLI MUST preserve durable pending-archive recovery before active OpenSpec preflight",
          "problem": "190 fixes the changed-surface outcome-unknown behavior, but does so by adding CLI-local archive recovery discovery in src/cli/change-action.ts: currentManifestActiveChangeId() parses the Delivery Manifest directly, pendingArchiveRecoveryProjection() scans .flowkit/runs, selects a pending archive, and invokes inspectOpenSpecArchiveRecovery() before Policy/FormalFact preparation. This duplicates lifecycle/persistence selection that the approved G1 Design says must remain in existing production services and creates a second archive recovery state machine in the CLI.",
          "contractRef": "G1 archive durable OpenSpec execution contract / G1 CLI E2E failure-recovery matrix / F1-D2 pending archive recovery semantics",
          "invariant": "A persisted archive outcome-unknown or mutation-surface recovery state must remain the same pending archive Run and surface recovery-required without respawning or requiring the active OpenSpec Change projection to still exist.",
          "requiredOutcome": "Keep the changed-surface outcome-unknown CLI behavior, but move/reuse the pre-OpenSpec pending-archive recovery discovery behind an existing or narrowly extended production service/authority boundary so the CLI only consumes one recovery projection. The CLI must not parse the Delivery Manifest, scan Run persistence, or independently select/classify archive recovery candidates.",
          "acceptance": [
            "The changed-surface outcome-unknown public CLI regression still returns recovery-required for the same runId, without respawn, replacement Run, terminalization, checkpoint or Git mutation.",
            "src/cli/change-action.ts no longer directly parses the Delivery Manifest or scans .flowkit/runs to select a pending archive recovery candidate.",
            "Pending archive candidate selection and inspectOpenSpecArchiveRecovery classification are owned by one existing/narrowly extended B1/F1/D2 production service boundary and are reused by the CLI.",
            "Normal Policy gating remains authoritative for ordinary archive invocation, and formal conflicts/stale lifecycle facts are not bypassed by a CLI-local preflight.",
            "After exact mechanical restoration plus existing explicit recovery admission, the same archive generation still resumes; happy archive, verify projection, selected Verification and G1 E2E regressions remain green.",
            "The fix remains inside the approved 186 apply/revise-apply mutation surface and does not introduce 03 Delivery behavior."
          ]
        }
      ],
      "convergence": [
