      "findings": [
        {
          "id": "I1-RA-001",
          "severity": "blocking",
          "blockingAuthority": "author",
          "title": "G1 real-process regression does not consume the propagated resolved OpenSpec executable authority",
          "problem": "218/219 approved Proposal freezes one resolved OpenSpec invocation identity shared by production adapter, Change Verification, G1 real-process regression and Delivery verification. In 220, executeVerificationSelection correctly propagates the current adapter's resolved executable through FLOWKIT_OPENSPEC_BIN, and the real OpenSpec suite consumes it. But G1's real-process fixture constructs default OpenSpec adapters / spawns the product CLI without consuming that propagated explicit identity. Therefore a legal explicit-resolved environment still requires an unrelated ambient PATH discovery for G1.",
          "contractRef": "218 approved Proposal `What Changes` first bullet; flowkit-openspec-1-7-thin-integration requirement `OpenSpec executable resolution 必须只有一个实际 invocation authority`; flowkit-change-verification-selection scenario `OpenSpec resolved executable identity is propagated from the current authority`",
          "invariant": "Once the current operation has resolved an OpenSpec executable identity, affected Verification consumers and the G1 real-process regression must consume that same authority and must not rediscover a second executable through an ambient PATH assumption.",
          "requiredOutcome": "Revise Apply so the G1 real-process regression consumes the same current resolved OpenSpec executable authority already supplied by Verification, without requiring a second repo-local or ambient PATH discovery. Preserve the existing production resolver/launcher authority and do not add a new executable registry or dependency.",
          "acceptance": [
            "With a valid explicit OpenSpec 1.7 executable supplied as the current resolved authority, no repo-local OpenSpec authority, and no independent openspec entry on ambient PATH, the selected G1 real-process regression passes all 7 scenarios.",
            "The real OpenSpec conformance suite continues to execute all 5 required cases in the same environment.",
            "PATH/global default, Windows ps1-only/cmd-only/both precedence, and explicit executable unit counterfactuals remain green.",
            "The fix stays within the approved I1 apply/revise-apply mutation surface or otherwise fails closed rather than silently expanding scope.",
            "No second executable discovery/persistence authority, project OpenSpec dependency, runner scheduler/concurrency change, or Delivery Full Test lifecycle behavior is introduced."
          ]
        }
      ]
