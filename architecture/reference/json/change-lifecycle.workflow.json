  "cards": [
    {
      "dot": "emerald",
      "title": "Workflow 主图：完整 Change",
      "items": [
        "explore → review-explore → propose → review-propose → Owner apply → apply → Verification → review-apply → Owner archive → archive → completed → Owner checkpoint → Git Checkpoint",
        "Git Change Checkpoint 在 completed 之后，是独立持久化边界，不是 Change Action / Run",
        "每个 formal Action 使用轻量 Run；Checkpoint 不消耗 Action/Run 序列"
      ]
    },
    {
      "dot": "amber",
      "title": "changes-requested ≠ revise-required",
      "items": [
        "只有 blockingAuthority=author 才进入 revise-*",
        "revise-explore / revise-propose 必须 re-review；revise-apply 必须 reverify 后再 review",
        "Owner / Verification / External blocker 停在各自 authority boundary，不机械制造 no-op revise"
      ]
    },
    {
      "dot": "cyan",
      "title": "Authority direction",
      "items": [
        "Owner decisions + Flowkit Policy + OpenSpec + Verification + canonical code/tests/Git facts → reference visualization",
        "Reference 只投影正式事实；never decides Policy，也不决定 Change contract、lifecycle 或 next Action",
        "如果 reference 与 formal facts 冲突，reference stale；formal facts win（formal facts 永远获胜）"
      ]
    },
    {
      "dot": "violet",
      "title": "Workflow 与 Sequence 的分工",
      "items": [
        "Workflow 表达完整 Change orchestration、分支、review/revise loop 与 non-author STOP boundary",
        "Sequence 补充 Owner / Policy / Author / Reviewer / Verification / OpenSpec / Git 的交互时序",
        "两者都只投影 formal facts；不成为第二 lifecycle authority，formal facts win"
      ]
    }
  ]
}
