{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Flowkit 完整 Change 执行 Workflow",
    "output": "change-lifecycle.workflow.html",
    "animation": "trace",
    "visual_preset": "signal-flow",
    "quality_profile": "standard",
    "views": [
      {
        "id": "explore-propose",
        "label": "Explore / Proposal 审查与修订",
        "focus": [
          "explore",
          "review_explore",
          "revise_explore",
          "propose",
          "review_propose",
          "revise_propose"
        ],
        "note": "显式展示 review-* 与仅 Author blocker 才进入 revise-* 的 re-review 回路。"
      },
      {
        "id": "apply-review",
        "label": "Apply / Verification / Review",
        "focus": [
          "authorize_apply",
          "apply",
          "change_verification",
          "review_apply",
          "revise_apply"
        ],
        "note": "Owner apply 授权、Change Verification、review-apply 与 author-only revise/reverify 分离。"
      },
      {
        "id": "authority-stop",
        "label": "非 Author blocker 停止边界",
        "focus": [
          "explore_authority_stop",
          "propose_authority_stop",
          "apply_authority_stop"
        ],
        "note": "changes-requested ≠ revise-required；Owner / Verification / External blocker 停在对应 authority boundary。"
      },
      {
        "id": "archive-checkpoint",
        "label": "Archive 与 Git Checkpoint",
        "focus": [
          "authorize_archive",
          "archive",
          "completed",
          "authorize_checkpoint",
          "checkpoint"
        ],
        "note": "archive 是 Change Action；completed 后才进入独立 Git Change Checkpoint boundary。"
      }
    ]
  },
  "lanes": [
    {
      "id": "explore_stage",
      "label": "Explore: explore → review-explore → (author-only revise-explore / re-review)"
    },
    {
      "id": "explore_stop",
      "label": "Explore non-Author blocker: Owner / Verification / External → STOP",
      "variant": "exception"
    },
    {
      "id": "proposal_stage",
      "label": "Proposal: propose → review-propose → (author-only revise-propose / re-review)"
    },
    {
      "id": "proposal_stop",
      "label": "Proposal non-Author blocker: Owner / Verification / External → STOP",
      "variant": "exception"
    },
    {
      "id": "apply_exec",
      "label": "Apply execution: Owner authorize-apply → apply → Change Verification"
    },
    {
      "id": "apply_review",
      "label": "Apply review: review-apply → (author-only revise-apply → reverify → re-review)"
    },
    {
      "id": "apply_stop",
      "label": "Apply non-Author blocker: Owner / Verification / External → STOP",
      "variant": "exception"
    },
    {
      "id": "close_stage",
      "label": "Close: Owner authorize-archive → OpenSpec archive"
    },
    {
      "id": "completed_lane",
      "label": "Change completed after archive success"
    },
    {
      "id": "checkpoint_gate",
      "label": "Owner authorize-checkpoint — separate Git persistence boundary"
    },
    {
      "id": "checkpoint_lane",
      "label": "Git Change Checkpoint — not Change Action / Run"
    }
  ],
  "mainPath": [
    "explore",
    "review_explore",
    "propose",
    "review_propose",
    "authorize_apply",
    "apply",
    "change_verification",
    "review_apply",
    "authorize_archive",
    "archive",
    "completed",
    "authorize_checkpoint",
    "checkpoint"
  ],
  "nodes": [
    {
      "id": "explore",
      "lane": "explore_stage",
      "col": 0,
      "width": 52,
      "type": "backend",
      "label": "Explore",
      "sublabel": "Author"
    },
    {
      "id": "review_explore",
      "lane": "explore_stage",
      "col": 1,
      "width": 52,
      "type": "security",
      "label": "Review",
      "sublabel": "explore"
    },
    {
      "id": "revise_explore",
      "lane": "explore_stage",
      "col": 2,
      "width": 52,
      "type": "backend",
      "label": "Revise",
      "sublabel": "explore",
      "tag": "author"
    },
    {
      "id": "explore_authority_stop",
      "lane": "explore_stop",
      "col": 2,
      "width": 52,
      "type": "external",
      "label": "STOP",
      "sublabel": "non-author",
      "tag": "STOP"
    },
    {
      "id": "propose",
      "lane": "proposal_stage",
      "col": 1,
      "width": 52,
      "type": "backend",
      "label": "Propose",
      "sublabel": "Author"
    },
    {
      "id": "review_propose",
      "lane": "proposal_stage",
      "col": 2,
      "width": 52,
      "type": "security",
      "label": "Review",
      "sublabel": "proposal"
    },
    {
      "id": "revise_propose",
      "lane": "proposal_stage",
      "col": 3,
      "width": 52,
      "type": "backend",
      "label": "Revise",
      "sublabel": "proposal",
      "tag": "author"
    },
    {
      "id": "propose_authority_stop",
      "lane": "proposal_stop",
      "col": 3,
      "width": 52,
      "type": "external",
      "label": "STOP",
      "sublabel": "non-author",
      "tag": "STOP"
    },
    {
      "id": "authorize_apply",
      "lane": "apply_exec",
      "col": 2,
      "width": 52,
      "type": "security",
      "label": "Auth",
      "sublabel": "apply",
      "tag": "Owner"
    },
    {
      "id": "apply",
      "lane": "apply_exec",
      "col": 3,
      "width": 52,
      "type": "backend",
      "label": "Apply",
      "sublabel": "Author"
    },
    {
      "id": "change_verification",
      "lane": "apply_exec",
      "col": 4,
      "width": 52,
      "type": "cloud",
      "label": "Verify",
      "sublabel": "checks",
      "tag": "Verification"
    },
    {
      "id": "review_apply",
      "lane": "apply_review",
      "col": 4,
      "width": 52,
      "type": "security",
      "label": "Review",
      "sublabel": "apply"
    },
    {
      "id": "revise_apply",
      "lane": "apply_review",
      "col": 5,
      "width": 52,
      "type": "backend",
      "label": "Revise",
      "sublabel": "apply",
      "tag": "author"
    },
    {
      "id": "apply_authority_stop",
      "lane": "apply_stop",
      "col": 5,
      "width": 52,
      "type": "external",
      "label": "STOP",
      "sublabel": "non-author",
      "tag": "STOP"
    },
    {
      "id": "authorize_archive",
      "lane": "close_stage",
      "col": 4,
      "width": 52,
      "type": "security",
      "label": "Auth",
      "sublabel": "archive",
      "tag": "Owner"
    },
    {
      "id": "archive",
      "lane": "close_stage",
      "col": 5,
      "width": 52,
      "type": "external",
      "label": "Archive",
      "sublabel": "OpenSpec"
    },
    {
      "id": "completed",
      "lane": "completed_lane",
      "col": 5,
      "width": 52,
      "type": "backend",
      "label": "Done",
      "sublabel": "Change"
    },
    {
      "id": "authorize_checkpoint",
      "lane": "checkpoint_gate",
      "col": 5,
      "width": 52,
      "type": "security",
      "label": "Auth",
      "sublabel": "Git",
      "tag": "Owner"
    },
    {
      "id": "checkpoint",
      "lane": "checkpoint_lane",
      "col": 5,
      "width": 52,
      "type": "database",
      "label": "Git CP",
      "sublabel": "Git",
      "tag": "not Action"
    }
  ],
  "edges": [
    {
      "from": "explore",
      "to": "review_explore",
      "variant": "emphasis"
