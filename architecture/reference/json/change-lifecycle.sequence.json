  "cards": [
    {
      "dot": "emerald",
      "title": "完整周期",
      "items": [
        "正式 Change Action 从 explore 开始，到 archive 结束",
        "archive 成功后 Change 才进入 completed",
        "Git Change Checkpoint 是完成后的持久化边界，不是 Action / Run"
      ]
    },
    {
      "dot": "amber",
      "title": "审查与修订",
      "items": [
        "changes-requested 不等于 revise-required",
        "只有 blockingAuthority=author 才进入 revise-*",
        "Owner / Verification / External blocker 必须停在对应权威边界"
      ]
    },
    {
      "dot": "cyan",
      "title": "验证与权威",
      "items": [
        "Verification 产生验证事实，Reviewer 产生 Verdict / Findings",
        "Owner 授权不能由 Author、Reviewer 或 Run prose 合成",
        "每个正式 Action 的 Run 保持三文件模型"
      ]
    },
    {
      "dot": "violet",
      "title": "Sequence 补充视角",
      "items": [
        "展示 Owner / Policy / Author / Reviewer / Verification / OpenSpec / Git 的参与者交互顺序",
        "完整分支语义仍以同源 Workflow 图表达；Sequence 不决定 Policy、Change contract 或 next Action",
        "与 canonical formal facts 冲突时 reference stale；formal facts win"
      ]
    }
  ]
