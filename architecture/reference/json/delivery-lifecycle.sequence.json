  "cards": [
    {
      "dot": "emerald",
      "title": "主闭环",
      "items": [
        "Delivery Start → Current / Planned → Changes → Ready → Full Test → Actual / Compare → Finalize → Delivery Final",
        "Full Test 与 Finalize 都不是 Change Action / Run",
        "每个 Change 仍完整走 02 生命周期"
      ]
    },
    {
      "dot": "rose",
      "title": "失败回路",
      "items": [
        "Full Test failed → Delivery Finding → Owner decision",
        "Owner 可创建 corrective Change；该 Change 仍走普通 Change lifecycle",
        "修正后必须重新达到 Ready，并重新获得 Full Test 授权"
      ]
    },
    {
      "dot": "cyan",
      "title": "架构边界",
      "items": [
        "Current / Planned / Actual JSON 是 Delivery 级 durable source",
        "HTML 是 Archify 生成的本地视图，不承担 architecture authority",
        "Compare 结果是结构证据，不等于 Reviewer 或 Owner verdict"
      ]
    },
    {
      "dot": "violet",
      "title": "Sequence 补充视角",
      "items": [
        "展示 Owner / Policy / Change execution / Verification / Archify / Architecture assets / Git 的交互顺序",
        "Full Test failed corrective loop 与 passed/finalize 分支仍以同源 Workflow 图表达；Sequence 不成为 lifecycle authority",
        "与 canonical formal facts 冲突时 reference stale；formal facts win"
      ]
    }
  ]
