{
  "name": "flowkit",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "flowkit": "dist/bin/flowkit.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run test:full",
    "test:focused": "node --import tsx scripts/verification.ts test:focused",
    "test:affected": "node --import tsx scripts/verification.ts test:affected",
    "test:full": "node --import tsx scripts/verification.ts test:full",
    "quality": "node --import tsx scripts/quality.ts",
    "verify:change": "node --import tsx scripts/verification.ts verify:change",
    "verify:full": "node --import tsx scripts/verification.ts verify:full",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
